.ipynb_checkpoints/

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Environment
.env
venv/
env/
*.env

# Weights & Biases
wandb/

# Misc
*.log
